{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2021",
          "parser": {
            "syntax": "typescript",
            "decorators": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          }
        },
        "module": {
          "type": "commonjs"
        },
        "sourceMaps": true
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(uuid)/)"
  ],
  "maxWorkers": 1,
  "workerIdleMemoryLimit": "512MB",
  "testTimeout": 30000
}
