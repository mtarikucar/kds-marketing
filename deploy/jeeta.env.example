# Inventory/template for /etc/jeeta/jeeta.env, root:root mode 0600.
# Blank assignments are placeholders, NOT a runnable production configuration.
# Fill required entries privately; remove unused optional entries. No shell expansion.
# Current validation: rust/bin/jeeta/src/config.rs; blanks count as unset.
# Production settings and provisioning: docs/operations/deployment.md.
# JEETA_TEST_DATABASE_URL appears only in config.rs tests; it is not service config.
# Never supply test-database configuration to this service.

# Required positive i64 integer in minor units; surrounding whitespace is not accepted.
JEETA_PRICE_MINOR=
# Required exactly three uppercase ASCII letters; no whitespace.
JEETA_PRICE_CURRENCY=
# Required nonblank text, at most 4096 UTF-8 bytes; do not commit real bank details.
JEETA_BANK_INSTRUCTIONS=
# Required PostgreSQL URL with postgres or postgresql scheme; trimmed.
# Use an ordinary schema-owning NOSUPERUSER NOBYPASSRLS role, never backup credentials.
JEETA_DATABASE_URL=
# Optional IP:port socket address (not a DNS name); defaults to loopback port 8080.
JEETA_BIND=
# Config accepts a nonblank path; boot REQUIRES an existing absolute private directory.
# No path component may be a symlink.
# Production FileStore: /var/lib/jeeta/files, within the unit's writable path.
JEETA_FILES_DIR=
# Optional trimmed path; production: /opt/jeeta/current/panel, containing index.html.
JEETA_PANEL_DIR=
# Optional case-insensitive true/false; defaults true. Production must use true.
JEETA_COOKIE_SECURE=
# Required exactly 64 hexadecimal characters (32 bytes); trimmed. Keep recovery copy.
JEETA_SECRET_KEY=
# Comma-separated host or host:port authorities, no scheme/path/user; numeric u16 port.
# Required for non-loopback bind; also set the public host behind a loopback proxy.
JEETA_ALLOWED_HOSTS=
# Optional pair with password; email trimmed here, validated/normalised at bootstrap.
# First setup only: remove both bootstrap entries after successful operator login.
JEETA_PLATFORM_BOOTSTRAP_EMAIL=
# Required with bootstrap email; preserved verbatim; bootstrap requires >=12 characters.
JEETA_PLATFORM_BOOTSTRAP_PASSWORD=
# Optional valid tracing EnvFilter; default and production filter: info,rmcp=warn.
JEETA_LOG=
# Optional compact/json, case-insensitive; default compact, production json.
JEETA_LOG_FORMAT=
# Optional true/false, case-insensitive, default false. REMOVE in production.
# JEETA_ALLOW_SUPERUSER=
# Optional 1/0 or case-insensitive true/false; default off. REMOVE in production.
# JEETA_ALLOW_TEST_LOOPBACK=
# Optional true/false, case-insensitive; default true. Sole production worker: true.
JEETA_JOBS_ENABLED=

# Each provider is optional, but configure its complete group or leave all entries unset.
# Any configured provider requires the public base URL. Values below are trimmed.
# Meta ID: nonblank with secret AND verify token; no further ID syntax check here.
JEETA_META_APP_ID=
# Meta secret: nonblank with ID and verify token; no further length check here.
JEETA_META_APP_SECRET=
# Meta verification token: nonblank, required with Meta app; no length check here.
JEETA_META_VERIFY_TOKEN=
# Optional nonblank login configuration ID; requires a complete Meta app.
JEETA_META_LOGIN_CONFIG_ID=
# Optional nonblank WhatsApp configuration ID; requires a complete Meta app.
JEETA_META_WHATSAPP_CONFIG_ID=
# Optional v<1-3 digits>.<1-3 digits>; defaults to adapter DEFAULT_GRAPH_VERSION.
# Setting it requires a complete Meta app.
JEETA_META_GRAPH_VERSION=
# Nonblank Instagram ID and secret are required together; no ID syntax check here.
JEETA_INSTAGRAM_APP_ID=
# Nonblank Instagram secret with ID; no further length check here.
JEETA_INSTAGRAM_APP_SECRET=
# Nonblank X client ID and secret are required together; no ID syntax check here.
JEETA_X_CLIENT_ID=
# Nonblank X client secret with ID; no further length check here.
JEETA_X_CLIENT_SECRET=
# Origin only: HTTPS host with optional port and trailing slash; no user/path/query/fragment.
# Config allows HTTP for loopback development; production FileStore requires public HTTPS.
# Config requires this for provider apps; boot also REQUIRES it for file transport.
JEETA_PUBLIC_BASE_URL=

# STDIO CLIENT ENVIRONMENT ONLY: never populate in the service EnvironmentFile.
# Optional trimmed nonblank string in config; mcp-stdio requires/authenticates a live key.
# Restart the stdio client process after revocation or issuer demotion.
# JEETA_STDIO_API_KEY=

# added by M4 Task 5/6 (not yet in this revision)
# Planned nonempty secret bearer token for /metrics; do not assume support yet.
# JEETA_METRICS_TOKEN=
# Planned absolute directory holding backup-status.json / wal-status.json (Tasks 5/9).
# Use a protected directory readable by jeeta; runtime writes must fit /var/lib/jeeta.
# JEETA_RECOVERY_STATUS_DIR=
# Planned recovery-only flag: JEETA_PLATFORM_BOOTSTRAP_RESET=1 requires email + password.
# After the one recovery start, remove ALL THREE bootstrap variables. Not supported yet.
# JEETA_PLATFORM_BOOTSTRAP_RESET=

# Activation code policy is fixed: 8 alphanumeric characters / 72 hours / 5 attempts.
# There are no environment settings for that policy.
