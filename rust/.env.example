# Yerel ayarlar. Kopyalayın: cp .env.example .env (.env git'e girmez) ve değerleri doldurun.
# Gerçek sırları yalnızca .env dosyasına yazın; bu dosyada yalnızca yer tutucular durur.
# Boş bırakılan isteğe bağlı bir değişken tanımsız sayılır. Ortamda zaten tanımlı değişkenler bu
# dosyadakileri ezer.

# Uygulamanın PostgreSQL bağlantısı (zorunlu). Rol süper kullanıcı olmamalı ve BYPASSRLS taşımamalı.
JEETA_DATABASE_URL=postgres://jeeta:change-me@localhost:5432/jeeta

# 64 onaltılık karakter (32 bayt), zorunlu. Üretmek için: openssl rand -hex 32
# Sır kutusunun ana anahtarı: bağlayıcı sırları her çalışma alanı için bundan türetilen bir anahtarla
# mühürlenir. Değiştirilirse önceden mühürlenmiş bağlayıcı yapılandırmaları açılamaz; yedekleyin.
JEETA_SECRET_KEY=replace-with-64-hex-characters

# HTTP sunucusunun dinlediği ip:port (varsayılan 127.0.0.1:8080).
JEETA_BIND=127.0.0.1:8080

# Derlenmiş panelin dizini (isteğe bağlı; boşsa yalnızca API ve MCP sunulur). Göreli yol, ikilinin
# çalıştırıldığı dizine göredir: rust/ içinden (make dev) panel/dist, depo kökünden rust/panel/dist.
JEETA_PANEL_DIR=panel/dist

# Oturum çerezlerinde Secure bayrağı (varsayılan true). Yalnızca yerel http için false yapın.
JEETA_COOKIE_SECURE=false

# MCP uç noktasının Host başlığında kabul ettiği genel adlar, virgülle (host ya da host:port), ör.
# jeeta.example.com,jeeta.example.com:8443. localhost, 127.0.0.1 ve ::1 her zaman kabul edilir.
# JEETA_BIND döngü (loopback) adresi değilse zorunludur.
JEETA_ALLOWED_HOSTS=

# İsteğe bağlı: ikisi birlikte doluysa ilk platform operatörü açılışta oluşturulur (parola en az 12
# karakter). Operatör oluştuktan sonra ikisini de silin.
JEETA_PLATFORM_BOOTSTRAP_EMAIL=
JEETA_PLATFORM_BOOTSTRAP_PASSWORD=
# Yalnız kurtarma: servis kapalıyken 1 yapın; tek eşleşen operatör gerekir.
# Kurtarma sonrası e-posta, parola ve bu bayrağı kaldırın.
JEETA_PLATFORM_BOOTSTRAP_RESET=

# `jeeta mcp-stdio` kipinin kullandığı API anahtarı (jt_live_...).
JEETA_STDIO_API_KEY=

# tracing süzgeci (varsayılan info,rmcp=warn), ör. info,rmcp=warn,jeeta=debug. rmcp=warn'u
# koruyun: rmcp her yeni MCP oturum kimliğini info düzeyinde yazar.
JEETA_LOG=info,rmcp=warn

# Günlük biçimi: compact (varsayılan) ya da json. Günlükler stderr'e yazılır.
JEETA_LOG_FORMAT=compact

# true ise veritabanı rolü süper kullanıcı ya da BYPASSRLS olsa da açılır (varsayılan false; o zaman
# açılış reddedilir). Çalışma alanı yalıtımı uygulanmaz: YALNIZCA yerel geliştirme için, üretimde asla.
JEETA_ALLOW_SUPERUSER=false

# 1 ise jt_outbound'un test-loopback özelliğiyle derlenmiş bir ikili de açılır (varsayılan kapalı; o
# zaman açılış reddedilir). Böyle bir ikili dış isteklerle bu makineye düz http ile ulaşabilir: YALNIZCA
# yerel test için, üretimde asla. Yayın ikilisini `cargo build --release -p jeeta` ile derleyin.
JEETA_ALLOW_TEST_LOOPBACK=

# Zamanlanmış işler (jeton yenileme, yoklamalar, NetGSM yoklamaları, temizlik) bu örnekte çalışsın mı
# (varsayılan true). false ise `jeeta serve` hiçbirini başlatmaz ve açılışta bunu günlüğe yazar.
# Aynı veritabanında birden çok örnek varsa işleri yalnız birinde açık bırakın: kilit yalnız aynı işin
# iki çalışmasının üst üste binmesini önler, örneklere sıra vermez.
JEETA_JOBS_ENABLED=true

# --- Sağlayıcı uygulamaları (platform yapılandırması; kiracı başına değil) ---
# Her uygulama isteğe bağlıdır ama bütün olarak yapılandırılır: kimliği ve sırrı birlikte (Meta için
# doğrulama anahtarı da). Yarım bir uygulama (kimlik var, sır yok ya da tersi) açılışı durdurur ve
# eksik değişkeni adıyla söyler. Bir uygulama yokken onun türleri OAuth ile bağlanamaz (409);
# NetGSM kimlik bilgileri panelde elle girilir, uygulama istemez. Gerçek değerler yalnız .env'e.

# Meta uygulaması (Facebook Login, Graph API, Meta webhook'ları): developers.facebook.com'daki
# uygulama kimliği ve sırrı.
JEETA_META_APP_ID=
JEETA_META_APP_SECRET=
# Meta'nın webhook adresini doğrularken geri yolladığı anahtar; Meta uygulamasıyla zorunlu. Kendiniz
# uzun rastgele bir değer üretin (openssl rand -hex 32) ve Meta panelinde Webhooks altına da girin.
JEETA_META_VERIFY_TOKEN=
# İsteğe bağlı: Facebook Login for Business yapılandırma kimliği (boşsa izinler tek tek istenir) ve
# WhatsApp gömülü kayıt yapılandırma kimliği.
JEETA_META_LOGIN_CONFIG_ID=
JEETA_META_WHATSAPP_CONFIG_ID=
# İsteğe bağlı: Graph API sürümü, ör. v19.0 (boşsa v19.0).
JEETA_META_GRAPH_VERSION=

# Instagram uygulaması (Instagram Login): Meta panelindeki Instagram uygulama kimliği ve sırrı.
JEETA_INSTAGRAM_APP_ID=
JEETA_INSTAGRAM_APP_SECRET=

# X uygulaması (OAuth 2.0 gizli istemci): developer.x.com'daki istemci kimliği ve sırrı.
JEETA_X_CLIENT_ID=
JEETA_X_CLIENT_SECRET=

# Panelin dışarıdan ulaşılan genel adresi: https://alan-adi (ya da https://alan-adi:port); yol,
# sorgu ya da parça yok. Yalnız yerel geliştirmede http://localhost:port olabilir. Herhangi bir
# sağlayıcı uygulaması yapılandırılmışsa zorunludur. OAuth yönlendirme adresleri
# ({adres}/oauth/callback/meta|instagram|x) ve webhook adresleri ({adres}/hooks/...) bundan kurulur;
# boşsa bağlantı başlatılamaz ve webhook adresleri gösterilmez. JEETA_ALLOWED_HOSTS'tan ayrıdır: o
# MCP uç noktasının kabul ettiği Host başlıklarıdır, bu ise sağlayıcılara verilen adrestir.
JEETA_PUBLIC_BASE_URL=

# Yalnızca testler: testlerin geçici veritabanları açtığı PostgreSQL sunucusunun yönetici adresi.
# Testler bu değeri ortam değişkeninden okur; kabuğunuzda export edin (bkz. README).
JEETA_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Required existing absolute directory on a persistent Linux volume, owned by the service (0700).
JEETA_FILES_DIR=/var/lib/jeeta/files
# JEETA_PUBLIC_BASE_URL must be a public HTTPS origin for signed file transport.

# Required one-time price and bank instructions; set deployment values.
JEETA_PRICE_MINOR=
JEETA_PRICE_CURRENCY=
JEETA_BANK_INSTRUCTIONS=

# Required for serve: nonempty secret bearer token for /metrics (never use an operator cookie).
JEETA_METRICS_TOKEN=
# Optional absolute path for verified backup-status.json and wal-status.json (README M4 Task 5).
JEETA_RECOVERY_STATUS_DIR=

# Optional absolute WAL archive directory. Requires JEETA_RECOVERY_STATUS_DIR.
# Confirmed PostgreSQL archiver success is probed every 60 seconds.
# Example: /var/backups/jeeta/wal
JEETA_WAL_ARCHIVE_DIR=

# Recovery commands only (protected environment; no implicit .env loading):
# JEETA_MASTER_KEY_FILE=/etc/jeeta/master-key.hex
# JEETA_RECOVERY_WORKSPACE_ID=<existing-workspace-uuid>
