# The voice bridge's environment (jeeta-voice-bridge.service), beside /etc/jeeta-voice/ari.env
# (ARI_PASSWORD). Installed as /etc/jeeta-voice/bridge.staging.env and bridge.prod.env (0600
# root); /etc/jeeta-voice/bridge.env is a symlink to the one in use. No value here is a secret but
# the key, which is filled in on the host only.
#
# The Jeeta this bridge serves, on loopback: 8091 staging, 8090 prod. One environment at a time.
JEETA_BASE_URL=http://127.0.0.1:8091
# The calls.bridge key of that environment's workspace (shown once when issued).
JEETA_BRIDGE_KEY=
VOICE_EXTENSION=102
ARI_URL=http://127.0.0.1:8188
ARI_USER=jeeta-voice
LISTEN_SOCKET=unix:/run/jeeta-voice/listen/listen.sock
SPEAK_SOCKET=unix:/run/jeeta-voice/speak/speak.sock
VOICE_CACHE_DIR=/var/lib/jeeta-voice/cache
VOICE_TRACE_FILE=/var/lib/jeeta-voice/traces.jsonl
# B7 read ack_ms 1 071 against its 1 000 ms criterion with the talker's 600 ms default: the
# endpoint and the final words (about 300 ms) come before the timer starts. 400 is the tuning the
# B6 review named; E3 confirms it (a turn's ack_ms <= 1 000) or moves it.
VOICE_ACK_MS=400
JEETA_VOICE_BRIDGE_LOG=info
